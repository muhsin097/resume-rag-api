// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Plan {
  FREE
  PREMIUM
}

enum ExperienceType {
  EXPERIENCE
  EDUCATION
  CERTIFICATION
  PROJECT
  ACHIEVEMENT
  SKILL
  LANGUAGE
}

// How much of startDate/endDate is actually known -- a DateTime column
// always has a day, but a resume import's source might only have said
// "2015" or "Jan 2015". Without this, a year-only date silently rendered
// as "Jan 2015" looks like an invented month. Null means DAY (the
// default -- manual entry via the date picker always gives a full date).
enum DatePrecision {
  YEAR
  MONTH
  DAY
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  // Null for accounts created via Google OAuth -- nothing to check a
  // password against, so login must reject those cleanly rather than
  // crash bcrypt.compare on null.
  passwordHash        String?            @map("password_hash")
  // Hash of the reset token, not the raw token -- a DB read alone
  // shouldn't be enough to take over an account the way a leaked raw
  // token would. Cleared on successful reset or once expired/unused.
  passwordResetTokenHash String?         @unique @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime?       @map("password_reset_expires_at")
  // Null means unverified. Set immediately for Google OAuth accounts
  // (Google already confirmed the email) and on successful OTP entry for
  // password accounts. Login is blocked while this is null.
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  emailVerificationCodeHash String?      @map("email_verification_code_hash")
  emailVerificationExpiresAt DateTime?   @map("email_verification_expires_at")
  name                String
  phone               String?
  location            String?
  bio                 String?            @db.Text
  linkedinUrl         String?            @map("linkedin_url")
  githubUrl           String?            @map("github_url")
  websiteUrl          String?            @map("website_url")
  jobSearchEnabled    Boolean            @default(true) @map("job_search_enabled")
  // PREMIUM is now a legacy/admin-only grandfather flag (manually set,
  // never purchasable) that bypasses the credit balance entirely --
  // unlimited generations, same as before this moved to prepaid packs.
  // Every new account is FREE and metered via creditsBalance below.
  plan                Plan               @default(FREE)
  // No longer the gate (creditsBalance is) -- kept as a historical/audit
  // trail of lifetime generations under the old unlimited-free-tier-count
  // model, and because the migration that introduced creditsBalance
  // backfilled from this value.
  freeGenerationsUsed Int                @default(0) @map("free_generations_used")
  // The actual gate for a FREE-plan user. Unit is deliberately finer than
  // "one generation" -- a full regenerate costs 2, a match-rescore costs
  // 1 (rescore only reruns analyzeMatch, never the expensive bullet-
  // writing call, so it's genuinely half the cost). Decremented as one
  // atomic conditional UPDATE (WHERE credits_balance >= amount),
  // immediately before the relevant Claude call -- never check-then-act
  // across two separate statements, which would let two concurrent
  // requests both pass a check against the same stale balance. Refunded
  // (incremented back) if the generation then fails after reservation.
  creditsBalance      Int                @default(4) @map("credits_balance")
  // Null means "no expiry yet" (the initial free-trial credits never
  // expire on their own). Set to now()+90d the moment a paid pack is
  // credited, and simply overwritten (not extended) by each subsequent
  // purchase -- one combined balance, one expiry, not per-purchase
  // batches; a deliberate simplification over FIFO-expiring batches.
  creditsExpireAt     DateTime?          @map("credits_expire_at")
  // Resume import (parsing an uploaded file into profile facts) is a
  // free onboarding utility, not a metered generation -- but with zero
  // cap it's an unmetered Claude cost vector (nothing stopped looping
  // the upload endpoint). Capped lifetime count, deliberately separate
  // from creditsBalance so imports don't eat into paid generation credits.
  resumeImportsUsed   Int                @default(0) @map("resume_imports_used")
  // Gates access to the separate admin dashboard app -- not exposed via any
  // user-facing update endpoint, only ever flipped by hand in the DB.
  isAdmin             Boolean            @default(false) @map("is_admin")
  createdAt           DateTime           @default(now()) @map("created_at")
  // Soft delete, not a real row removal -- email, freeGenerationsUsed, and
  // creditsBalance/creditsExpireAt are deliberately kept so delete-then-
  // re-register can't be used to farm a fresh free-generation allowance.
  // login() is already blocked (passwordHash is cleared on delete);
  // register() reactivates a matching deleted row instead of creating a
  // new one when this is set.
  deletedAt           DateTime?          @map("deleted_at")
  experienceItems     ExperienceItem[]
  resumeGenerations   ResumeGeneration[]
  creditPurchases     CreditPurchase[]

  @@map("users")
}

// One row per Razorpay Order created for a credit-pack purchase -- created
// (status PENDING) the moment the user starts checkout, before any payment
// has actually happened, so there's always a row to reconcile the webhook
// against. Only the webhook (server-to-server, signature-verified) ever
// moves a row to PAID and credits the account -- the client-side checkout
// success callback is UX feedback only, never trusted to grant credits
// itself, since a client redirect can be spoofed without ever paying.
model CreditPurchase {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack              CreditPack
  credits           Int
  amountPaise       Int            @map("amount_paise")
  razorpayOrderId   String         @unique @map("razorpay_order_id")
  // Null until the webhook actually reports a captured payment -- a
  // PENDING row with no payment id is a normal, expected state for an
  // order the user started but never completed.
  razorpayPaymentId String?        @unique @map("razorpay_payment_id")
  status            PurchaseStatus @default(PENDING)
  createdAt         DateTime       @default(now()) @map("created_at")
  paidAt            DateTime?      @map("paid_at")

  @@map("credit_purchases")
  @@index([userId])
}

enum CreditPack {
  STARTER
  JOB_SEARCH
  INTENSIVE
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

// One row per resume "fact": a job, a degree, a cert, a project, an achievement, or a skill.
// This is the corpus RAG retrieves from -- the atomic unit a tailored resume gets assembled out of.
model ExperienceItem {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ExperienceType
  title        String
  organization String?
  description String?          @db.Text
  // Only meaningful for type SKILL -- a short resume-style grouping label
  // ("Languages & Frameworks", "Cloud & DevOps", ...) assigned once via
  // classifySkillCategories when the skill is first created, then reused
  // by every export/generation. Null for every other type, and briefly
  // null for a SKILL between creation and that classification call.
  category     String?         @map("category")
  startDate    DateTime?        @map("start_date")
  endDate      DateTime?        @map("end_date")
  startDatePrecision DatePrecision? @map("start_date_precision")
  endDatePrecision   DatePrecision? @map("end_date_precision")
  // endDate null is ambiguous on its own -- "still ongoing" and "ended,
  // exact date unknown" look identical. This disambiguates: true only
  // means a real present-tense/ongoing signal was found (stated
  // explicitly on import, or checked explicitly on manual entry). False
  // with a null endDate means "ended, date just not known" -- NOT
  // "currently here". Only meaningful for EXPERIENCE/EDUCATION/PROJECT
  // (the date-range types); ignored for CERTIFICATION (single date).
  isCurrent    Boolean          @default(false) @map("is_current")
  // Normalized text actually sent to the embedding model -- derived from the fields above.
  content      String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  embedding    ExperienceEmbedding?

  @@map("experience_items")
  @@index([userId])
}

// Kept separate from ExperienceItem so the embedding model can change later
// (re-embed into a new column/table) without touching the source data.
model ExperienceEmbedding {
  id               String         @id @default(uuid())
  experienceItemId String         @unique @map("experience_item_id")
  experienceItem   ExperienceItem @relation(fields: [experienceItemId], references: [id], onDelete: Cascade)
  // 512 dims == Voyage `voyage-3-lite`. Prisma has no query-builder support for
  // pgvector ops, so similarity search against this column is raw SQL ($queryRaw).
  embedding        Unsupported("vector(512)")
  model            String
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("experience_embeddings")
}

// Recruiters are a separate persona, not a kind of User -- they have no
// experience items, nothing in common with the candidate model, so they
// get their own table and their own auth rather than overloading User
// with a pile of irrelevant nullable fields.
model Recruiter {
  id                 String   @id @default(uuid())
  email              String   @unique
  // Both null for accounts created via Google OAuth -- no password to
  // check, and Google doesn't hand us a company name at signup.
  passwordHash       String?  @map("password_hash")
  name               String
  companyName        String?  @map("company_name")
  // Spends against RECRUITER_FREE_CREDITS_LIMIT -- gates the LLM-ranked
  // "best 3 fits" search, not the free cosine-based search itself.
  rankingCreditsUsed Int      @default(0) @map("ranking_credits_used")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("recruiters")
}

model ResumeGeneration {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription   String   @db.Text @map("job_description")
  // Extracted from the JD text at generation time, so History can show
  // "Senior Engineer at Acme" instead of a raw JD snippet. Null when the
  // posting doesn't clearly state one (never guessed).
  jobTitle         String?  @map("job_title")
  companyName      String?  @map("company_name")
  retrievedItemIds Json     @map("retrieved_item_ids")
  // Flat text, derived from structuredContent -- kept as the display
  // fallback for rows created before structuredContent existed, and as
  // the input to analyzeMatch (which needs a plain string, not JSON).
  generatedContent String   @db.Text @map("generated_content")
  // Null for generations created before this field existed. Export
  // (DOCX/PDF) requires this -- see resume-export module.
  structuredContent Json?   @map("structured_content")
  // Two deliberately separate signals, not one blended number: fitScore is
  // Claude's holistic judgment of overall candidate fit (considers the
  // whole profile, not just literal JD keyword presence -- can exceed or
  // fall short of keywordCoverage). keywordCoverage is a plain, explainable
  // percentage computed in code from matched/missing below (never an LLM
  // guess), so "everything matched" always means exactly 100 there.
  fitScore         Int      @default(0) @map("match_score")
  keywordCoverage  Int      @default(0) @map("keyword_coverage")
  matchedKeywords  String[] @default([]) @map("matched_keywords")
  missingKeywords  String[] @default([]) @map("missing_keywords")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("resume_generations")
  @@index([userId])
}
