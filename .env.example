DATABASE_URL="postgresql://resumerag:resumerag@localhost:5433/resumerag?schema=public"
PORT=3000

# Shared with resume-rag-web's NEXTAUTH_SECRET / AUTH_SECRET -- NestJS verifies the JWT NextAuth issues.
JWT_SECRET="change-me-to-a-long-random-string"

# CORS: the Next.js app's origin
WEB_ORIGIN="http://localhost:3001"

# https://dashboard.voyageai.com (free tier)
VOYAGE_API_KEY=""
VOYAGE_EMBEDDING_MODEL="voyage-3-lite"

# https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Lifetime cap on free resume-import (upload-and-parse) calls per account --
# separate from paid generation credits. Optional, defaults to 5.
FREE_IMPORT_LIMIT=5

# https://dashboard.razorpay.com/app/keys -- use Test Mode keys for local
# dev. Credit-pack purchases silently fail (lazy client, same pattern as
# RESEND_API_KEY) until these are set; nothing else depends on them.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# https://dashboard.razorpay.com/app/webhooks -- set when creating the
# webhook pointing at POST /payments/webhook, subscribed to at least
# payment.captured.
RAZORPAY_WEBHOOK_SECRET=""

# https://sentry.io -- error monitoring. Unset locally is fine, the SDK
# no-ops without a DSN; no point reporting dev-machine errors.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
